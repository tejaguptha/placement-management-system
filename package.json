{
  "name": "placement-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Placement Management System deploy-ready for Vercel",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "seed": "node backend/seed.js",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"node backend/server.js\" \"npm --prefix frontend run dev\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.29",
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=18.x"
  }
}
